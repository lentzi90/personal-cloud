# Collabora Online configuration (KinD environment)
#
# WOPI is served by the OpenCloud proxy itself on its own domain (the
# "collaboration" service runs inside the OpenCloud process, see
# opencloud/overlays/kind/config.env), so aliasgroup1 is the OpenCloud
# domain, not a separate wopiserver domain.
aliasgroup1=https://opencloud.test.local
# TLS is terminated at the gateway, which forwards plain HTTP to coolwsd:
# ssl.enable=false with ssl.termination=true. Certificate verification of
# OpenCloud stays off because the KinD gateway uses a self-signed certificate.
# index 14 is used to avoid conflicts with existing LOK allow entries
extra_params=--o:ssl.enable=false --o:ssl.ssl_verification=false --o:ssl.termination=true --o:welcome.enable=false --o:net.frame_ancestors=opencloud.test.local --o:net.lok_allow.host[14]=opencloud.test.local --o:home_mode.enable=false
username=admin
password=admin
