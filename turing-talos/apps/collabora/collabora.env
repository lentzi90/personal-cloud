# Collabora Online configuration (turing-talos environment)
#
# WOPI is served by the OpenCloud proxy itself on its own domain (the
# "collaboration" service runs inside the OpenCloud process, see
# turing-talos/apps/opencloud/config.env), so aliasgroup1 is the OpenCloud
# domain, not a separate wopiserver domain.
aliasgroup1=https://opencloud.jern.fi
# index 14 is used to avoid conflicts with existing LOK allow entries
extra_params=--o:ssl.enable=true --o:ssl.ssl_verification=false --o:ssl.termination=true --o:welcome.enable=false --o:net.frame_ancestors=opencloud.jern.fi --o:net.lok_allow.host[14]=opencloud.jern.fi --o:home_mode.enable=false
