# OpenCloud OIDC Configuration for Keycloak Integration (KinD environment)
# These settings configure OpenCloud to use Keycloak as the identity provider.
#
# Only the built-in identity *provider* (idp) is disabled. The built-in identity
# *manager* (idm) keeps running and stays the user/group directory.
OC_EXCLUDE_RUN_SERVICES=idp

# OIDC issuer URL (Keycloak realm URL for KinD).
# OC_OIDC_ISSUER is picked up by the proxy, web, users and webfinger services.
OC_OIDC_ISSUER=https://keycloak.local/realms/openCloud

# Web client configuration
WEB_OIDC_CLIENT_ID=web

# The built-in idp normally serves /.well-known/openid-configuration. With idp
# disabled the proxy has to rewrite it to the Keycloak issuer instead.
PROXY_OIDC_REWRITE_WELLKNOWN=true

# User claim mapping: look up the account in OpenCloud by username
PROXY_USER_OIDC_CLAIM=preferred_username
PROXY_USER_CS3_CLAIM=username

# Provision accounts that only exist in Keycloak on first sign-in
PROXY_AUTOPROVISION_ACCOUNTS=true

# Role assignment (claims from Keycloak). The built-in mapping already maps
# opencloudAdmin, opencloudSpaceAdmin, opencloudUser and opencloudGuest, and it
# can only be overridden through a config file, not through env variables.
PROXY_ROLE_ASSIGNMENT_DRIVER=oidc
PROXY_ROLE_ASSIGNMENT_OIDC_CLAIM=roles

# OIDC token validation
PROXY_OIDC_ACCESS_TOKEN_VERIFY_METHOD=jwt
PROXY_OIDC_SKIP_USER_INFO=false
